---
/*
  Hero.astro
  ------------------------------------------------------------------------
  The first thing a visitor sees. Two columns on desktop (text left,
  photo right), stacking to one column on mobile via CSS Grid + a
  media query (see <style> below).

  The signature visual moment here is the animated ring of "circuit
  traces" around your photo — a dashed circle whose dash pattern
  animates, so it reads like a signal travelling around a PCB trace.
  It's drawn with plain SVG + CSS, no JS/animation library required.
------------------------------------------------------------------------- */
import SocialLinks from './SocialLinks.astro';
// Astro's built-in image component: at build time it generates an
// optimised, correctly-sized, modern-format (e.g. WebP) version of this
// photo instead of shipping the original JPEG as-is — this is what the
// Astro analyser was flagging. It needs the image to be `import`ed from
// inside src/ (here: src/assets/profile.jpg) rather than referenced as a
// plain string path into /public, which is why the image now lives in
// src/assets/ as well as public/ (the public copy is kept only for the
// <link rel="icon"> favicon in Layout.astro, which can't use this
// component).
import { Image } from 'astro:assets';
import profilePhoto from '../assets/profile.jpg';
---

<section id="top" class="hero">
  <!-- Faint dot-grid background, purely decorative (aria-hidden) -->
  <div class="hero-grid" aria-hidden="true"></div>

  <div class="container hero-inner">
    <div class="hero-text">
      <p class="eyebrow"><span class="led-dot"></span>Available for graduate & junior roles</p>

      <h1>
        Musawandile Shamase
      </h1>
      <p class="hero-title">
        Electronics &amp; Computer Engineering Graduate <span class="divider-dot">·</span> Control Systems &amp; Industrial Automation <b>[PLC] </b>
      </p>

      <p class="hero-summary">
        BEngTech graduate from the Durban University of Technology, with a strong
        technical foundation in electronic circuit design, control systems,
        embedded systems, and software development, and currently deepening my
        industrial-automation skillset through a PLC Programming Certification
        from <a href="https://www.plcdojo.com/" class="hero-title" target="_blank">PLC Dojo</a>. I like taking a problem from schematic to working
        prototype.
      </p>

      <div class="hero-actions">
        <a
          class="btn btn-primary"
          href="/Musawandile-Shamase-Resume.pdf"
          download="Musawandile-Shamase-Resume.pdf"
        >
          Download Resume
        </a>
        <a class="btn btn-ghost" href="#projects">View Projects</a>
      </div>

      <div class="hero-socials">
        <SocialLinks />
      </div>
    </div>

    <div class="hero-photo-wrap">
      <!-- Animated dashed ring drawn behind the photo -->
      <svg class="photo-ring" viewBox="0 0 300 300" aria-hidden="true">
        <circle cx="150" cy="150" r="140" class="ring-track" />
        <circle cx="150" cy="150" r="140" class="ring-trace" />
      </svg>
      <Image
        src={profilePhoto}
        alt="Portrait of Musawandile Shamase"
        class="hero-photo"
        width={480}
        height={480}
      />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding: var(--space-xl) 0 var(--space-lg);
    overflow: hidden;
  }

  /* Subtle repeating dot pattern using a CSS radial-gradient background,
     instead of an image — keeps the page lightweight. */
  .hero-grid {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(var(--border-color) 1px, transparent 1px);
    background-size: 34px 34px;
    opacity: 0.18;
    mask-image: radial-gradient(ellipse at center, black 30%, transparent 75%);
    pointer-events: none;
  }

  .hero-inner {
    position: relative;
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: var(--space-lg);
    align-items: center;
  }

  .hero-title {
    font-family: var(--font-mono);
    font-size: 0.95rem;
    color: var(--teal);
    margin-bottom: var(--space-sm);
  }
  .divider-dot {
    color: var(--border-color);
  }

  .hero h1 {
    font-size: clamp(2.4rem, 5vw, 3.4rem);
    margin-bottom: var(--space-xs);
  }

  .hero-summary {
    max-width: 46ch;
    color: var(--text-color);
    margin-bottom: var(--space-md);
  }

  .hero-actions {
    display: flex;
    gap: var(--space-sm);
    flex-wrap: wrap;
    margin-bottom: var(--space-md);
  }

  /* ---- Photo + animated ring ------------------------------------- */
  .hero-photo-wrap {
    position: relative;
    justify-self: center;
    width: min(340px, 80vw);
    aspect-ratio: 1 / 1;
  }

  .hero-photo {
    position: absolute;
    inset: 14%;
    width: 72%;
    height: 72%;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid var(--border-color);
  }

  .photo-ring {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  /* The static, dim full circle "track" the trace runs along */
  .ring-track {
    fill: none;
    stroke: var(--divider-color);
    stroke-width: 1.5;
  }

  /* The bright teal dash that travels around the ring, like a signal
     pulse moving along a circuit trace. stroke-dasharray creates short
     dashes with big gaps; animating stroke-dashoffset moves them. */
  .ring-trace {
    fill: none;
    stroke: var(--teal);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-dasharray: 18 70;
    filter: drop-shadow(0 0 5px var(--teal));
    animation: travel 6s linear infinite;
  }

  @keyframes travel {
    to {
      stroke-dashoffset: -880; /* roughly the ring's circumference */
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ring-trace {
      animation: none;
    }
  }

  /* ---- Responsive: stack to one column on smaller screens --------- */
  @media (max-width: 900px) {
    .hero-inner {
      grid-template-columns: 1fr;
      text-align: center;
    }
    .hero-summary {
      margin-left: auto;
      margin-right: auto;
      /* Override the global justify on small screens: the stacked mobile
         layout centers everything else here, so keep this centered too
         instead of justified. */
      text-align: center;
    }
    .hero-actions,
    .hero-socials {
      justify-content: center;
    }
    .hero-socials {
      display: flex;
    }
    .hero-photo-wrap {
      order: -1;
    }
  }
</style>
