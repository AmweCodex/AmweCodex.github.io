---
/*
  Hero.astro
  ------------------------------------------------------------------------
  The first thing a visitor sees. Left: who I am, what I do and the main
  buttons. Right: my photo in a framed "panel" with two live status chips
  (the certificate I hold and the level I am working on now), like the
  indicator lights on a PLC rack. Under both sits a row of four numbers
  that count themselves from the content folders, so they never go stale.

  The photo is imported from src/assets so Astro can resize and compress
  it at build time (the original stays in /public only for social previews).
------------------------------------------------------------------------- */
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import profilePhoto from '../assets/profile.jpg';
import SocialLinks from './SocialLinks.astro';

const posts = await getCollection('blog', ({ data }) => !data.draft);
const projects = await getCollection('projects', ({ data }) => !data.draft);
const certificates = await getCollection('certificates', ({ data }) => !data.draft);

const labPosts = posts.filter((post) => post.data.category.includes('PLC-LAB')).length;

const stats = [
  { value: String(certificates.length), label: certificates.length === 1 ? 'PLC certificate' : 'PLC certificates' },
  { value: String(labPosts), label: 'PLC-LAB write-ups' },
  { value: String(posts.length), label: 'Blog posts' },
  { value: String(projects.length), label: projects.length === 1 ? 'Project' : 'Projects' },
];
---

<section id="top" class="hero">
  <div class="hero-grid" aria-hidden="true"></div>

  <div class="container hero-inner">
    <div class="hero-text">
      <p class="eyebrow"><span class="led-dot"></span>Available immediately · Graduate &amp; junior roles</p>

      <h1>
        Musawandile<br />
        <span class="surname">Shamase</span>
      </h1>

      <p class="hero-role">
        Electronics &amp; Computer Engineer <span class="sep">/</span> Control Systems &amp; Industrial Automation <b>[PLC]</b>
      </p>

      <p class="hero-summary">
        BEngTech graduate from the Durban University of Technology with a
        foundation in electronic circuit design, control systems, embedded
        systems and software. I'm now building my industrial-automation
        skills with <a href="https://www.plcdojo.com/" target="_blank" rel="noopener noreferrer">PLC Dojo</a>{' '}
        and documenting every practice problem here, from the first rung to a
        tested program.
      </p>

      <div class="hero-actions">
        <a
          class="btn btn-primary"
          href="/Musawandile-Shamase-Resume.pdf"
          download="Musawandile-Shamase-Resume.pdf"
        >
          Download Resume
        </a>
        <a class="btn btn-ghost" href="/blog">Read the Blog</a>
        <a class="btn btn-ghost" href="/projects">View Projects</a>
      </div>

      <div class="hero-socials">
        <SocialLinks />
      </div>
    </div>

    <div class="hero-panel">
      <div class="photo-frame">
        <Image
          src={profilePhoto}
          alt="Portrait of Musawandile Shamase"
          class="hero-photo"
          width={480}
          height={480}
          loading="eager"
        />
        <!-- corner brackets, like the registration marks on a PCB -->
        <span class="corner tl"></span><span class="corner tr"></span>
        <span class="corner bl"></span><span class="corner br"></span>
      </div>

      <div class="chip chip-done">
        <span class="chip-icon" aria-hidden="true">✓</span>
        <span><b>PLC Fundamentals</b> (Level I)</span>
      </div>
      <div class="chip chip-live">
        <span class="status-blink" aria-hidden="true"></span>
        <span><b>Applied Logic</b> (Level 2) in progress</span>
      </div>
    </div>
  </div>

  <div class="container">
    <dl class="stats">
      {stats.map((stat) => (
        <div class="stat">
          <dt>{stat.label}</dt>
          <dd>{stat.value}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding: var(--space-xl) 0 var(--space-lg);
    overflow: hidden;
  }

  /* Faint grid, fading out towards the edges. Pure CSS, no image. */
  .hero-grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(var(--border-color) 1px, transparent 1px),
      linear-gradient(90deg, var(--border-color) 1px, transparent 1px);
    background-size: 48px 48px;
    opacity: 0.12;
    mask-image: radial-gradient(ellipse at 70% 40%, black 15%, transparent 70%);
    pointer-events: none;
  }

  .hero-inner {
    position: relative;
    display: grid;
    grid-template-columns: 1.25fr 0.75fr;
    gap: var(--space-xl);
    align-items: center;
  }

  .hero h1 {
    font-size: clamp(2.6rem, 6vw, 4.2rem);
    line-height: 1.02;
    letter-spacing: -0.02em;
    margin-bottom: var(--space-sm);
  }
  .surname {
    color: var(--teal);
  }

  .hero-role {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    color: var(--heading-color);
    margin-bottom: var(--space-sm);
    text-align: left;
  }
  .hero-role .sep {
    color: var(--border-color);
    margin: 0 0.25rem;
  }
  .hero-role b {
    color: var(--teal);
    font-weight: 500;
  }

  .hero-summary {
    max-width: 52ch;
    margin-bottom: var(--space-md);
  }
  .hero-summary a {
    color: var(--teal);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .hero-actions {
    display: flex;
    gap: var(--space-sm);
    flex-wrap: wrap;
    margin-bottom: var(--space-md);
  }

  /* ---- Photo panel ------------------------------------------------ */
  .hero-panel {
    position: relative;
    justify-self: center;
    width: min(340px, 78vw);
  }

  .photo-frame {
    position: relative;
    padding: 14px;
    border: 1px solid var(--border-color);
    border-radius: 22px;
    background: var(--bg-secondary);
    box-shadow: 0 24px 60px -30px var(--shadow-color);
  }
  .photo-frame :global(.hero-photo) {
    width: 100%;
    height: auto;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    border-radius: 50%; /* the portrait is a circle, so crop it as one */
  }

  .corner {
    position: absolute;
    width: 22px;
    height: 22px;
    border: 2px solid var(--teal);
    opacity: 0.9;
  }
  .tl { top: -6px; left: -6px; border-right: 0; border-bottom: 0; border-top-left-radius: 8px; }
  .tr { top: -6px; right: -6px; border-left: 0; border-bottom: 0; border-top-right-radius: 8px; }
  .bl { bottom: -6px; left: -6px; border-right: 0; border-top: 0; border-bottom-left-radius: 8px; }
  .br { bottom: -6px; right: -6px; border-left: 0; border-top: 0; border-bottom-right-radius: 8px; }

  /* Status chips overlapping the frame */
  .chip {
    position: absolute;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.85rem;
    border-radius: 999px;
    border: 1px solid var(--border-color);
    background: var(--bg-secondary);
    font-size: 0.78rem;
    color: var(--text-color);
    white-space: nowrap;
    box-shadow: 0 10px 28px -12px var(--shadow-color);
  }
  .chip b {
    color: var(--heading-color);
    font-weight: 600;
  }
  .chip-done {
    left: -1.25rem;
    bottom: 4.25rem;
    border-color: var(--teal-border);
  }
  .chip-icon {
    color: var(--teal);
    font-weight: 700;
  }
  .chip-live {
    right: -1.25rem;
    bottom: -1rem;
  }
  .status-blink {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--teal);
    box-shadow: 0 0 8px var(--teal-glow);
    animation: blink 1.6s ease-in-out infinite;
  }
  @keyframes blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.25; }
  }

  /* ---- Numbers row ------------------------------------------------ */
  .stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    margin: var(--space-xl) 0 0;
    border: 1px solid var(--border-color);
    border-radius: 14px;
    background: var(--bg-secondary);
    overflow: hidden;
  }
  .stat {
    display: flex;
    flex-direction: column-reverse; /* number above its label */
    padding: var(--space-sm) var(--space-md);
  }
  .stat + .stat {
    border-left: 1px solid var(--divider-color);
  }
  .stat dd {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.9rem;
    font-weight: 600;
    color: var(--heading-color);
    line-height: 1.1;
  }
  .stat dt {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-color);
  }

  @media (prefers-reduced-motion: reduce) {
    .status-blink {
      animation: none;
    }
  }

  /* ---- Smaller screens -------------------------------------------- */
  @media (max-width: 900px) {
    .hero-inner {
      grid-template-columns: 1fr;
      gap: var(--space-lg);
    }
    .hero-panel {
      order: -1;
      margin-bottom: var(--space-sm);
    }
    .stats {
      grid-template-columns: repeat(2, 1fr);
    }
    .stat:nth-child(3) {
      border-left: 0;
    }
    .stat:nth-child(n + 3) {
      border-top: 1px solid var(--divider-color);
    }
  }
  @media (max-width: 520px) {
    .chip-done { left: 0; }
    .chip-live { right: 0; }
    .hero-summary { text-align: left; }
  }
</style>
