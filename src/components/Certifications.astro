---
/*
  Certifications.astro
  ------------------------------------------------------------------------
  Education + the two certifications currently in progress. The
  "In Progress" ones get a small animated status pill instead of a plain
  label, so it's visually obvious at a glance which credentials are
  already complete vs. still being worked on.
------------------------------------------------------------------------- */
const education = {
  degree: 'Bachelor of Engineering Technology (BEngTech), Electronics & Computer Engineering',
  school: 'Durban University of Technology (DUT), Durban, South Africa',
  status: 'Graduated 2025',
};

const certifications = [
  {
    name: 'PLC Programming Certification',
    focus: 'PLC Programming, PLC Architecture, Scan Cycles, Digital/Analog I/O, Ladder Logic, Timers & Counters, Industrial Automation',
    inProgress: true,
  }
];
---

<section id="certifications" class="section alt-section">
  <div class="container">
    <p class="eyebrow"><span class="led-dot"></span>Education &amp; Certifications</p>
    <h2>Learning, always running</h2>

    <div class="cert-card card education-card">
      <h3>{education.degree}</h3>
      <p class="cert-meta">{education.school}</p>
      <span class="status-pill status-done">{education.status}</span>
    </div>

    <div class="cert-grid">
      {certifications.map((cert) => (
        <div class="cert-card card">
          <div class="cert-heading">
            <h3>{cert.name}</h3>
            {cert.inProgress && (
              <span class="status-pill status-progress">
                <span class="status-blink"></span> In Progress
              </span>
            )}
          </div>
          <p class="cert-meta">{cert.focus}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .education-card {
    margin-top: var(--space-md);
    background: var(--bg-primary);
  }

  .cert-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: var(--space-md);
    margin-top: var(--space-md);
  }

  .cert-card {
    background: var(--bg-primary);
  }

  .cert-heading {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-xs);
    margin-bottom: var(--space-xs);
  }
  .cert-heading h3 {
    margin-bottom: 0;
    font-size: 1.05rem;
  }

  .cert-meta {
    color: var(--text-color);
    font-size: 0.88rem;
    margin: 0;
  }

  .status-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.05em;
    padding: 0.3rem 0.7rem;
    border-radius: 999px;
    white-space: nowrap;
  }

  .status-done {
    color: var(--teal);
    border: 1px solid var(--teal-border);
    margin-top: var(--space-xs);
  }

  .status-progress {
    color: var(--heading-color);
    border: 1px solid var(--border-color);
  }

  /* Small blinking dot — signals "actively running", like an indicator
     LED on a live PLC rack. */
  .status-blink {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--teal);
    animation: blink 1.6s ease-in-out infinite;
  }

  @keyframes blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.25; }
  }

  @media (prefers-reduced-motion: reduce) {
    .status-blink {
      animation: none;
    }
  }
</style>
