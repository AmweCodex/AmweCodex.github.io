---
/*
  Certifications.astro
  ------------------------------------------------------------------------
  Education + certifications. Finished certificates are read from
  src/content/certificates/ (so adding one with `npm run new:certificate`
  updates this section by itself). Courses still being studied are listed
  in `inProgress` below; when one is finished, delete it from that list and
  add its certificate.
------------------------------------------------------------------------- */
import { getCollection } from 'astro:content';

const education = {
  degree: 'Bachelor of Engineering Technology (BEngTech), Electronics & Computer Engineering',
  school: 'Durban University of Technology (DUT), Durban, South Africa',
  status: 'Graduated 2025',
};

const completed = (await getCollection('certificates', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const inProgress = [
  {
    name: 'Applied Logic (Level 2)',
    provider: 'PLC Dojo',
    focus: 'The next level of the PLC Programming Certification, building on the Level I fundamentals.',
  },
];
---

<section id="certifications" class="section alt-section">
  <div class="container">
    <p class="eyebrow"><span class="led-dot"></span>Education &amp; Certifications</p>
    <h2>Learning, always running</h2>

    <div class="cert-card card education-card">
      <h3>{education.degree}</h3>
      <p class="cert-meta">{education.school}</p>
      <span class="status-pill status-done">{education.status}</span>
    </div>

    <div class="cert-grid">
      {completed.map(({ data }) => (
        <div class="cert-card card">
          <div class="cert-heading">
            <h3>{data.title}</h3>
            <span class="status-pill status-done">Completed</span>
          </div>
          <p class="cert-meta">{data.provider} · {data.date.toLocaleDateString('en-ZA', { month: 'long', year: 'numeric' })}</p>
          <p class="cert-meta">{data.summary}</p>
          {(data.link || data.pdf) && (
            <a class="cert-link" href={data.link ?? data.pdf} target="_blank" rel="noopener noreferrer">
              {data.link ? 'Verify certificate' : 'View certificate'} &rarr;
            </a>
          )}
        </div>
      ))}

      {inProgress.map((cert) => (
        <div class="cert-card card">
          <div class="cert-heading">
            <h3>{cert.name}</h3>
            <span class="status-pill status-progress">
              <span class="status-blink"></span> In Progress
            </span>
          </div>
          <p class="cert-meta">{cert.provider}</p>
          <p class="cert-meta">{cert.focus}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .education-card {
    margin-top: var(--space-md);
    background: var(--bg-primary);
  }

  .cert-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: var(--space-md);
    margin-top: var(--space-md);
  }

  .cert-card {
    background: var(--bg-primary);
  }

  .cert-heading {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-xs);
    margin-bottom: var(--space-xs);
  }
  .cert-heading h3 {
    margin-bottom: 0;
    font-size: 1.05rem;
  }

  .cert-meta {
    color: var(--text-color);
    font-size: 0.88rem;
    margin: 0 0 0.4rem;
    text-align: left;
  }

  .cert-link {
    display: inline-block;
    margin-top: var(--space-xs);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--teal);
  }
  .cert-link:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .status-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.05em;
    padding: 0.3rem 0.7rem;
    border-radius: 999px;
    white-space: nowrap;
  }

  .status-done {
    color: var(--teal);
    border: 1px solid var(--teal-border);
  }
  .education-card .status-done {
    margin-top: var(--space-xs);
  }

  .status-progress {
    color: var(--heading-color);
    border: 1px solid var(--border-color);
  }

  /* Small blinking dot — signals "actively running", like an indicator
     LED on a live PLC rack. */
  .status-blink {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--teal);
    animation: blink 1.6s ease-in-out infinite;
  }

  @keyframes blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.25; }
  }

  @media (prefers-reduced-motion: reduce) {
    .status-blink {
      animation: none;
    }
  }
</style>
