---
/*
  ProjectCard.astro
  ------------------------------------------------------------------------
  One card, reused in two places: the "latest projects" preview on the
  homepage, and the full grid on /projects. Takes a single content
  collection entry as a prop and reads its frontmatter off `entry.data`.

  The whole card is wrapped in a single <a>, so clicking anywhere on the
  card — not just the title — opens the project's detail page at
  /projects/<id>. That detail page shows the FULL markdown write-up;
  this card only ever shows the short `summary` field, which is what
  keeps the listing pages scannable.
------------------------------------------------------------------------- */
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'projects'>;
}

const { entry } = Astro.props;
const { title, summary, cover, stack } = entry.data;
---

<a class="project-card card" href={`/projects/${entry.id}`}>
  <div class="card-image">
    <img src={cover} alt="" loading="lazy" />
  </div>
  <div class="card-body">
    <h3>{title}</h3>
    <p class="card-summary">{summary}</p>
    {stack.length > 0 && (
      <div class="tag-row">
        {stack.slice(0, 3).map((item) => <span class="tag">{item}</span>)}
      </div>
    )}
  </div>
</a>

<style>
  .project-card {
    display: flex;
    flex-direction: column;
    padding: 0;
    overflow: hidden;
  }

  .card-image {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--bg-primary);
    border-bottom: 1px solid var(--divider-color);
  }
  .card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }
  .project-card:hover .card-image img {
    transform: scale(1.05);
  }

  .card-body {
    padding: var(--space-md);
  }

  .card-body h3 {
    font-size: 1.05rem;
    margin-bottom: var(--space-xs);
  }

  .card-summary {
    font-size: 0.9rem;
    color: var(--text-color);
    margin-bottom: var(--space-sm);
    /* Clamp to 3 lines so cards of different summary lengths still line up */
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .tag-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
</style>
