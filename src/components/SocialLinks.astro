---
/*
  SocialLinks.astro
  ------------------------------------------------------------------------
  One place that lists your social links. Both Hero.astro and Footer.astro
  render <SocialLinks /> instead of each hard-coding the same four links —
  if a handle ever changes, you only edit it here.

  Icons are plain inline SVGs (no icon-library dependency to install).
  Each uses stroke="currentColor" so it automatically inherits whatever
  text color the surrounding CSS sets — that's why we can style hover
  color with a single CSS rule instead of touching the SVG markup.
------------------------------------------------------------------------- */
const socials = [
  {
    name: 'GitHub',
    href: 'https://github.com/AmweCodex',
    icon: 'github',
  },
  {
    name: 'LinkedIn',
    href: 'http://linkedin.com/in/musawandile-shamase',
    icon: 'linkedin',
  },
  {
    name: 'Email',
    href: 'mailto:shamasemusawandile@gmail.com',
    icon: 'email',
  },
  {
    name: 'YouTube',
    href: 'http://youtube.com/@AmweCodex',
    icon: 'youtube',
  },
];
---

<div class="social-links">
  {socials.map((s) => (
    <a href={s.href} target="_blank" rel="noopener noreferrer" aria-label={s.name} title={s.name}>
      {s.icon === 'github' && (
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6">
          <path d="M12 2C6.5 2 2 6.6 2 12.2c0 4.5 2.9 8.3 6.9 9.6.5.1.7-.2.7-.5v-1.9c-2.8.6-3.4-1.4-3.4-1.4-.5-1.1-1.1-1.5-1.1-1.5-.9-.6.1-.6.1-.6 1 .1 1.5 1 1.5 1 .9 1.5 2.3 1.1 2.9.8.1-.7.4-1.1.6-1.4-2.3-.3-4.6-1.1-4.6-5 0-1.1.4-2 1-2.7-.1-.3-.5-1.3.1-2.6 0 0 .9-.3 2.8 1a9.7 9.7 0 0 1 5.2 0c2-1.3 2.8-1 2.8-1 .6 1.3.2 2.3.1 2.6.6.7 1 1.6 1 2.7 0 3.9-2.3 4.7-4.6 5 .4.3.7 1 .7 2v2.9c0 .3.2.6.7.5 4-1.3 6.9-5.1 6.9-9.6C22 6.6 17.5 2 12 2Z"/>
        </svg>
      )}
      {s.icon === 'linkedin' && (
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6">
          <rect x="3" y="3" width="18" height="18" rx="2.5" />
          <path d="M7.5 10v7M7.5 7.2v.1M11.5 17v-4c0-1.4 1-2.5 2.5-2.5s2.5 1.1 2.5 2.5v4M11.5 10v7" stroke-linecap="round" />
        </svg>
      )}
      {s.icon === 'email' && (
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6">
          <rect x="3" y="5" width="18" height="14" rx="2" />
          <path d="M3.5 6.5 12 13l8.5-6.5" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      )}
      {s.icon === 'youtube' && (
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6">
          <rect x="2.5" y="5.5" width="19" height="13" rx="3.5" />
          <path d="M10.5 9.5v5l4.3-2.5-4.3-2.5Z" fill="currentColor" stroke="none" />
        </svg>
      )}
    </a>
  ))}
</div>

<style>
  .social-links {
    display: flex;
    gap: var(--space-sm);
  }
  .social-links a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1px solid var(--border-color);
    color: var(--text-color);
    transition: color 0.15s ease, border-color 0.15s ease, transform 0.15s ease;
  }
  .social-links a:hover {
    color: var(--teal);
    border-color: var(--teal);
    transform: translateY(-2px);
  }
</style>
