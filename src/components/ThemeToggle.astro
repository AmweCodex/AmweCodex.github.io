---
/*
  ThemeToggle.astro
  ------------------------------------------------------------------------
  A round button in the header that switches between three modes:

      Auto (follows the device)  →  Light  →  Dark  →  back to Auto

  The icon shows the mode you are in now: a monitor for Auto, a sun for
  Light, a moon for Dark.

  The real work (saving the choice, changing the colours) is done by
  window.__setTheme(), which is defined by the small script in the <head>
  of Layout.astro. This file only draws the button and reacts to clicks.
------------------------------------------------------------------------- */
---

<button class="theme-toggle" type="button" aria-label="Change colour theme">
  <!-- Auto: a monitor -->
  <svg class="icon icon-auto" viewBox="0 0 24 24" aria-hidden="true">
    <rect x="3" y="4" width="18" height="12" rx="2"></rect>
    <path d="M8 20h8M12 16v4"></path>
  </svg>
  <!-- Light: a sun -->
  <svg class="icon icon-light" viewBox="0 0 24 24" aria-hidden="true">
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>
  </svg>
  <!-- Dark: a moon -->
  <svg class="icon icon-dark" viewBox="0 0 24 24" aria-hidden="true">
    <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
  </svg>
</button>

<style>
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.4rem;
    height: 2.4rem;
    padding: 0;
    border-radius: 50%;
    border: 1px solid var(--border-color);
    background: transparent;
    color: var(--text-color);
    cursor: pointer;
    transition:
      border-color 0.15s ease,
      color 0.15s ease;
  }
  .theme-toggle:hover {
    border-color: var(--teal);
    color: var(--teal);
  }

  /* Hidden until the head script has run. Without JavaScript the button
     could not do anything, so it stays out of sight instead. */
  :global(:root:not([data-theme-pref])) .theme-toggle {
    display: none;
  }

  .icon {
    display: none;
    width: 1.15rem;
    height: 1.15rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  /* Show only the icon that matches the chosen mode */
  :global(:root[data-theme-pref='auto']) .icon-auto,
  :global(:root[data-theme-pref='light']) .icon-light,
  :global(:root[data-theme-pref='dark']) .icon-dark {
    display: block;
  }
</style>

<script>
  type Pref = 'auto' | 'light' | 'dark';

  const ORDER: Pref[] = ['auto', 'light', 'dark'];
  const NAMES: Record<Pref, string> = {
    auto: 'Auto (follows your device)',
    light: 'Light',
    dark: 'Dark',
  };

  const button = document.querySelector<HTMLButtonElement>('.theme-toggle');

  const currentPref = (): Pref =>
    (document.documentElement.dataset.themePref as Pref | undefined) ?? 'auto';
  const nextPref = (): Pref => ORDER[(ORDER.indexOf(currentPref()) + 1) % ORDER.length];

  // Screen readers and the hover tooltip say what the button does
  function updateLabel() {
    if (!button) return;
    const text = `Theme: ${NAMES[currentPref()]}. Click for ${NAMES[nextPref()]}.`;
    button.setAttribute('aria-label', text);
    button.title = text;
  }

  button?.addEventListener('click', () => {
    (window as any).__setTheme(nextPref());
    updateLabel();
  });

  // Another tab may change the theme, so refresh the label when that happens
  window.addEventListener('storage', updateLabel);
  updateLabel();
</script>
