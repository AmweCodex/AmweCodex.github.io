---
/*
  index.astro
  ------------------------------------------------------------------------
  The homepage. Assembles sections in order, wrapped in the shared Layout.
  Skills moved out to /about (see about.astro) — this page now shows a
  preview of the 3 latest projects and 3 latest blog posts instead, each
  linking through to their full listing page.
------------------------------------------------------------------------- */
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import ProjectsPreview from '../components/ProjectsPreview.astro';
import BlogPreview from '../components/BlogPreview.astro';
import Experience from '../components/Experience.astro';
import Certifications from '../components/Certifications.astro';
import LadderRung from '../components/LadderRung.astro';
---

<Layout title="Musawandile Shamase — Electronics & Computer Engineering">
  <Hero />
  <LadderRung label="PROJECTS" />
  <ProjectsPreview />
  <LadderRung label="BLOG" />
  <BlogPreview />
  <LadderRung label="EXPERIENCE" />
  <Experience />
  <Certifications />
</Layout>
