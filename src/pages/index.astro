---
/*
  index.astro
  ------------------------------------------------------------------------
  The homepage. Assembles sections in order, wrapped in the shared Layout.
  Order: hero, PLC-LAB learning path, latest blog posts, latest projects,
  experience, education & certifications. Skills live on /about.
------------------------------------------------------------------------- */
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import LabProgress from '../components/LabProgress.astro';
import ProjectsPreview from '../components/ProjectsPreview.astro';
import BlogPreview from '../components/BlogPreview.astro';
import Experience from '../components/Experience.astro';
import Certifications from '../components/Certifications.astro';
import LadderRung from '../components/LadderRung.astro';
---

<Layout title="Musawandile Shamase">
  <Hero />
  <LadderRung label="PLC-LAB" />
  <LabProgress />
  <BlogPreview />
  <LadderRung label="PROJECTS" />
  <ProjectsPreview />
  <LadderRung label="EXPERIENCE" />
  <Experience />
  <Certifications />
</Layout>
