---
/*
  src/pages/blog/[...id].astro  →  e.g. /blog/starting-my-plc-journey
  ------------------------------------------------------------------------
  Same pattern as src/pages/projects/[...id].astro — see the comments
  there for how getStaticPaths() + render() work, and why "..." matters.
  This version reads from the "blog" collection instead of "projects".
  Posts live in category folders (e.g. blog/PLC/, blog/PLC-LAB/), so the
  address of a post includes the folder: /blog/plc/plc-timers. That is why
  [...id] (with the dots) is needed here.
------------------------------------------------------------------------- */
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { formatDate, readingMinutes } from '../../lib/blog';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((entry) => {
    // Neighbours in the same category, oldest to newest, for the
    // "Previous / Next" links at the bottom of the post.
    const series = posts
      .filter((post) => post.data.category === entry.data.category)
      .sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf());
    const index = series.findIndex((post) => post.id === entry.id);
    return {
      params: { id: entry.id },
      props: { entry, previous: series[index - 1], next: series[index + 1] },
    };
  });
}

const { entry, previous, next } = Astro.props;
const { title, cover, tags, date, category } = entry.data;
const { Content, headings } = await render(entry);

const formattedDate = formatDate(date);
const minutes = readingMinutes(entry.body);
// "On this page" list: only the main sections, and only for longer posts
const contents = headings.filter((heading) => heading.depth === 2);
---

<Layout title={`${title}`} description={entry.data.summary} image={cover} type="article">
  <article class="section post-detail">
    <div class="container narrow">
      <a class="back-link" href="/blog">&larr; All posts</a>

      <p class="eyebrow"><span class="led-dot"></span>{formattedDate} · {minutes} min read</p>
      <h1>{title}</h1>
      <p class="post-category">{category}</p>

      {tags.length > 0 && (
        <div class="tag-row">
          {tags.map((tag) => <span class="tag">{tag}</span>)}
        </div>
      )}

      <div class="cover-image">
        <img src={cover} alt="" />
      </div>

      {contents.length >= 3 && (
        <details class="toc">
          <summary>On this page</summary>
          <ol>
            {contents.map((heading) => (
              <li><a href={`#${heading.slug}`}>{heading.text}</a></li>
            ))}
          </ol>
        </details>
      )}

      <div class="prose">
        <Content />
      </div>

      {(previous || next) && (
        <nav class="post-nav" aria-label="More posts in this category">
          {previous ? (
            <a class="post-nav-link" href={`/blog/${previous.id}`}>
              <span class="post-nav-label">&larr; Previous</span>
              <span class="post-nav-title">{previous.data.title}</span>
            </a>
          ) : <span></span>}
          {next ? (
            <a class="post-nav-link post-nav-next" href={`/blog/${next.id}`}>
              <span class="post-nav-label">Next &rarr;</span>
              <span class="post-nav-title">{next.data.title}</span>
            </a>
          ) : <span></span>}
        </nav>
      )}
    </div>
  </article>
</Layout>

<style>
  .container.narrow {
    max-width: max(760px, 75%);
  }

  .back-link {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--text-color);
    margin-bottom: var(--space-md);
    transition: color 0.15s ease;
  }
  .back-link:hover {
    color: var(--teal);
  }

  .post-detail h1 {
    font-size: clamp(1.9rem, 4vw, 2.6rem);
    margin-top: var(--space-xs);
  }

  .post-category {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-color);
    margin: var(--space-xs) 0 0;
    text-align: left;
  }

  .tag-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: var(--space-sm) 0 var(--space-md);
  }

  .cover-image {
    border-radius: 14px;
    overflow: hidden;
    border: 1px solid var(--border-color);
    margin-bottom: var(--space-lg);
  }
  .cover-image img {
    width: 100%;
    display: block;
  }

  .prose :global(h2),
  .prose :global(h3) {
    scroll-margin-top: 5rem;
  }
  .prose :global(h2) {
    font-size: 1.4rem;
    margin-top: var(--space-lg);
  }
  .prose :global(h3) {
    font-size: 1.15rem;
    margin-top: var(--space-md);
  }
  .prose :global(p) {
    margin-bottom: var(--space-sm);
  }
  .prose :global(ul),
  .prose :global(ol) {
    padding-left: 1.3rem;
    margin-bottom: var(--space-sm);
  }
  .prose :global(li) {
    margin-bottom: 0.4rem;
  }
  .prose :global(strong) {
    color: var(--heading-color);
  }
  .prose :global(code) {
    font-family: var(--font-mono);
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    padding: 0.1rem 0.4rem;
    border-radius: 4px;
    font-size: 0.85em;
  }
  .prose :global(a) {
    color: var(--teal);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .prose :global(blockquote) {
    border-left: 3px solid var(--teal);
    padding-left: var(--space-sm);
    color: var(--text-color);
    font-style: italic;
    margin: var(--space-md) 0;
  }

  /* "On this page" list */
  .toc {
    border: 1px solid var(--border-color);
    border-radius: 12px;
    background: var(--bg-secondary);
    padding: 0.8rem 1.1rem;
    margin-bottom: var(--space-md);
  }
  .toc summary {
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--teal);
  }
  .toc ol {
    margin: var(--space-xs) 0 0;
    padding-left: 1.3rem;
    font-size: 0.92rem;
  }
  .toc li {
    margin-bottom: 0.25rem;
  }
  .toc a:hover {
    color: var(--teal);
  }

  /* Previous / next post */
  .post-nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-sm);
    margin-top: var(--space-xl);
    padding-top: var(--space-md);
    border-top: 1px solid var(--divider-color);
  }
  .post-nav-link {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding: var(--space-sm) var(--space-md);
    border: 1px solid var(--border-color);
    border-radius: 12px;
    background: var(--bg-secondary);
    transition: border-color 0.15s ease;
  }
  .post-nav-link:hover {
    border-color: var(--teal);
  }
  .post-nav-next {
    text-align: right;
    grid-column: 2;
  }
  .post-nav-label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--teal);
  }
  .post-nav-title {
    color: var(--heading-color);
    font-weight: 500;
  }
  @media (max-width: 600px) {
    .post-nav {
      grid-template-columns: 1fr;
    }
    .post-nav-next {
      grid-column: 1;
    }
  }
</style>
