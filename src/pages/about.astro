---
/*
  src/pages/about.astro  →  the page at /about
  ------------------------------------------------------------------------
  Skills.astro is unchanged from before — same component, same card
  styling — it's just imported and rendered here instead of on the
  homepage now.
------------------------------------------------------------------------- */
import Layout from '../layouts/Layout.astro';
import Skills from '../components/Skills.astro';
---

<Layout title="About — Musawandile Shamase" description="About Musawandile Shamase — Electronics & Computer Engineering graduate.">
  <section class="section about-intro">
    <div class="container narrow">
      <p class="eyebrow"><span class="led-dot"></span>About</p>
      <h1>About me</h1>
      <p>
        I'm a <strong style="color: #cad2e2;">BEngTech</strong> graduate in <strong style="color: #cad2e2;">Electronics &amp; Computer Engineering</strong> from the <strong style="color: #cad2e2;">Durban University of Technology</strong>, with a foundation spanning
        embedded systems, electronic circuit design, control systems and
        software development, built through modules like Electronic Circuit
        Design, Digital Signal Processing and Fundamentals of Control
        Systems, several of which I passed with distinction.
      </p>
      <p>
        What I enjoy most is taking a project from a concept to working
        hardware: I've built an automated irrigation system that reads soil
        moisture to control watering, a cable fault detection system that
        pinpoints faults in electrical and signal cabling, and a car safety
        interlock system that uses microcontroller interrupts to validate
        safety conditions in real time.
      </p>
      <p>
        I'm currently deepening my industrial-automation skills through a
        PLC Programming Certification, and teaching myself further with
        free tools like CODESYS and many other platforms, documenting the whole journey here as I
        go, one project and blog post at a time.
      </p>
    </div>
  </section>

  <!-- Same Skills component and card style as before, just living here now -->
  <Skills />
</Layout>

<style>
  .container.narrow {
    max-width: max(760px, 80%);
  }

  .about-intro p {
    color: var(--text-color);
  }
</style>
